# --- Database (Turso) ---------------------------
# Local dev can use a file DB:  DATABASE_URL="file:local.db"
DATABASE_URL="libsql://<db-name>-<org>.turso.io"
DATABASE_AUTH_TOKEN=""

# --- Admin login --------------------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""            # plain text, min 10 chars
# Generate both with:  npm run gen-secrets
SESSION_SECRET=""
CRON_SECRET=""

# --- Shopify ------------------------------------
# Optional display name (default: the Shopify shop name)
STORE_NAME=
SHOPIFY_STORE_DOMAIN="<store>.myshopify.com"
# Dev Dashboard app (dev.shopify.com) → your app → Settings → Credentials
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Only for old admin-created apps (token starts with shpat_). Otherwise leave empty.
SHOPIFY_ADMIN_TOKEN=""

# --- Couriers -----------------------------------
POSTEX_TOKEN=""
