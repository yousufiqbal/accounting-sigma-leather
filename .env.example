# --- Database (Turso) ---------------------------
# Local dev can use a file DB:  DATABASE_URL="file:local.db"
DATABASE_URL="libsql://<db-name>-<org>.turso.io"
DATABASE_AUTH_TOKEN=""

# --- Admin login --------------------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""            # plain text, min 10 chars
# Generate both with:  npm run gen-secrets
SESSION_SECRET=""
CRON_SECRET=""

# --- Shopify ------------------------------------
SHOPIFY_STORE_DOMAIN="<store>.myshopify.com"
SHOPIFY_ADMIN_TOKEN=""

# --- Couriers -----------------------------------
POSTEX_TOKEN=""
